   "source": [
    "import uvarint\n",
    "\n",
    "x = 4\n",
    "\n",
    "encoded = uvarint.encode(x)\n",
    "print(' '.join(f'{byte:08b}' for byte in encoded))\n",
    "\n",
    "decoded, _ = uvarint.decode(encoded)\n",
    "print(decoded)"
   ]
  },
